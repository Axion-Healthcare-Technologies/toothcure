---
import Reveal from "./Reveal";
import Eyebrow from "./Eyebrow.astro";
import ResponsivePicture from "./ResponsivePicture.astro";
import { site, waLink } from "../data/site";
const { doctor } = site;
---
<section id="doctor" class="bg-sand">
  <Reveal client:visible className="max-w-7xl mx-auto px-5 py-20 lg:py-24 grid lg:grid-cols-[.75fr_1.25fr] gap-10 items-center">
    <div data-reveal-item class="rounded-[2rem] overflow-hidden bg-white shadow-soft">
      <ResponsivePicture
        name="doctor-portrait"
        widths={[640, 960, 1200]}
        fallbackWidth={960}
        sizes="(min-width: 1024px) 850px, calc((100vw - 40px) * 1.9)"
        alt={doctor.imageAlt}
        width={1200}
        height={800}
        class="w-full aspect-[4/5] object-cover"
        style="object-position:32% 50%"
      />
    </div>
    <div data-reveal-item>
      <Eyebrow>{doctor.eyebrow}</Eyebrow>
      <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold">{doctor.heading}</h2>
      <p class="mt-6 text-slate-600 leading-8">{doctor.text}</p>
      <div class="mt-7 grid sm:grid-cols-2 gap-4">
        {doctor.facts.map((f) => (
          <div class="bg-white rounded-2xl p-5 border border-slate-200">
            <span class="text-xs text-slate-500">{f.label}</span>
            <p class="mt-1 font-bold">{f.value}</p>
          </div>
        ))}
      </div>
      <a href={waLink()} class="btn-lift mt-7 inline-flex rounded-xl bg-teal text-white px-6 py-3.5 font-bold hover:bg-teal-dark focus-ring">{doctor.cta}</a>
    </div>
  </Reveal>
</section>
