---
import Reveal from "./Reveal";
import { site, waLink, telHref } from "../data/site";
interface Props { text?: string }
const { text = site.cta.text } = Astro.props;
const { cta } = site;
---
<section id="contact" class="max-w-7xl mx-auto px-5 pb-20 lg:pb-24">
  <Reveal client:visible>
    <div data-reveal-item class="rounded-[2rem] bg-teal text-white px-6 py-12 sm:px-10 lg:px-14 lg:py-16 text-center">
      <p class="text-sm font-bold uppercase tracking-[.18em]">{cta.eyebrow}</p>
      <h2 class="mt-3 text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight">{cta.heading}</h2>
      <p class="mt-4 max-w-2xl mx-auto leading-7">{text}</p>
      <div class="mt-8 flex flex-col sm:flex-row justify-center gap-3">
        <a href={waLink()} class="btn-lift inline-flex justify-center items-center rounded-xl bg-white text-teal px-7 py-3.5 font-bold focus-ring">{cta.primary}</a>
        <a href={telHref} class="btn-lift inline-flex justify-center items-center rounded-xl border border-white/40 px-7 py-3.5 font-bold hover:bg-white/10 focus-ring">{cta.secondary}</a>
      </div>
    </div>
  </Reveal>
</section>
