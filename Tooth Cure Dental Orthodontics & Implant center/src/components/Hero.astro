---
import ResponsivePicture from "./ResponsivePicture.astro";
import { site, waLink, telHref } from "../data/site";
const { hero, contact } = site;
const badge = "inline-flex items-center gap-2 rounded-full bg-white border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-700";
---
<section class="hero-grid bg-sand overflow-hidden">
  <div class="max-w-7xl mx-auto px-5 py-14 sm:py-20 lg:py-24 grid lg:grid-cols-[1.05fr_.95fr] gap-10 lg:gap-16 items-center">
    <div>
      <div class="hero-in inline-flex flex-wrap items-center gap-2 mb-6" style="--i:0">
        <span class={badge}><span class="h-2 w-2 rounded-full bg-teal" aria-hidden="true"></span>{hero.badges[0]}</span>
        {hero.badges.slice(1).map((b) => <span class={badge}>{b}</span>)}
        <span class={badge}><span class="live-dot h-2 w-2 rounded-full bg-teal" aria-hidden="true"></span>{hero.openBadge}</span>
      </div>
      <p class="hero-in text-sm font-bold uppercase tracking-[.18em] text-teal mb-4" style="--i:0">{hero.eyebrow}</p>
      <h1 class="hero-in text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.04] max-w-3xl" style="--i:0">
        {hero.headline}{" "}
        <span class="type-wrap text-teal" id="typeWrap" data-phrases={JSON.stringify(hero.phrases)}>
          {hero.phrases.map((p) => <span class="type-ghost" aria-hidden="true">{p}</span>)}
          <span>
            <span id="typed">{hero.phrases[0]}</span><span class="type-caret" aria-hidden="true"></span>
          </span>
        </span>
      </h1>
      <p class="hero-in mt-6 text-lg text-slate-600 leading-8 max-w-2xl" style="--i:1">{hero.text}</p>
      <div class="hero-in mt-8 flex flex-col sm:flex-row gap-3" style="--i:2">
        <a href={waLink()} class="btn-lift inline-flex justify-center items-center gap-2 rounded-xl bg-teal text-white px-6 py-3.5 font-bold shadow-soft hover:bg-teal-dark focus-ring">{hero.primary} <span aria-hidden="true">→</span></a>
        <a href={telHref} class="btn-lift inline-flex justify-center items-center gap-2 rounded-xl bg-white border border-slate-200 px-6 py-3.5 font-bold hover:border-teal hover:text-teal focus-ring">{hero.secondary}</a>
      </div>
      <div class="hero-in mt-8 flex flex-wrap gap-x-6 gap-y-3 text-sm text-slate-600" style="--i:3">
        {hero.checks.map((c) => <span>✓ {c}</span>)}
      </div>
      <div class="hero-in mt-9 flex items-center gap-4 border-t border-slate-200 pt-6 max-w-xl" style="--i:4">
        <div class="h-12 w-12 rounded-full bg-teal/10 grid place-items-center text-teal font-bold">{hero.chip.initials}</div>
        <div>
          <p class="font-bold">{hero.chip.title}</p>
          <p class="text-sm text-slate-600">{hero.chip.text}</p>
        </div>
      </div>
    </div>
    <div class="hero-in relative" style="--i:0">
      <div class="rounded-[2rem] overflow-hidden bg-slate-100 shadow-soft">
        <ResponsivePicture
          name="hero-dentist-patient"
          widths={[640, 960, 1400]}
          fallbackWidth={960}
          sizes="(min-width: 1024px) 640px, 105vw"
          alt={hero.imageAlt}
          width={1400}
          height={933}
          eager
          class="w-full aspect-[4/3] object-cover"
          style="object-position:40% 50%"
        />
      </div>
      <div class="hero-in absolute -bottom-5 left-4 right-4 sm:left-6 sm:right-auto bg-white rounded-2xl shadow-card border border-slate-100 p-4 max-w-sm" style="--i:3">
        <p class="text-xs font-bold uppercase tracking-wider text-teal">{hero.card.title}</p>
        <p class="mt-1 text-sm text-slate-600">{hero.card.text}</p>
      </div>
    </div>
  </div>
</section>

<script>
  // Live typing headline. Stops on its own when the page is swapped out by the router.
  function initTyping() {
    const wrap = document.getElementById("typeWrap");
    const el = document.getElementById("typed");
    if (!wrap || !el || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const phrases: string[] = JSON.parse(wrap.dataset.phrases ?? "[]");
    if (phrases.length < 2) return;

    let pi = 0;
    let ci = phrases[0].length;
    let typing = false;

    const tick = () => {
      if (!el.isConnected) return;
      const word = phrases[pi];
      let delay: number;
      if (typing) {
        ci++;
        el.textContent = word.slice(0, ci);
        if (ci >= word.length) { typing = false; delay = 2200; } else delay = 55 + Math.random() * 55;
      } else {
        ci--;
        el.textContent = word.slice(0, Math.max(ci, 0));
        if (ci <= 0) { typing = true; pi = (pi + 1) % phrases.length; delay = 380; } else delay = 28;
      }
      setTimeout(tick, delay);
    };
    // First cycle starts after a pause so the headline reads before it changes.
    setTimeout(tick, 2600);
  }
  document.addEventListener("astro:page-load", initTyping);
</script>
