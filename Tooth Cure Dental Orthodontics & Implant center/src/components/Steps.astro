---
import Reveal from "./Reveal";
import Eyebrow from "./Eyebrow.astro";
import { site } from "../data/site";
const { steps } = site;
---
<section id="how" class="max-w-7xl mx-auto px-5 pb-20 lg:pb-24">
  <Reveal client:visible>
    <div data-reveal-item class="max-w-2xl">
      <Eyebrow>{steps.eyebrow}</Eyebrow>
      <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold tracking-tight">{steps.heading}</h2>
    </div>
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {steps.items.map((s, i) => (
        <div data-reveal-item>
          <div class="lift h-full rounded-3xl border border-slate-200 p-6 sm:p-7">
            <span class="h-11 w-11 rounded-2xl bg-mist grid place-items-center text-teal font-bold">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="mt-6 text-2xl font-bold">{s.title}</h3>
            <p class="mt-2 text-slate-600 leading-7">{s.text}</p>
          </div>
        </div>
      ))}
    </div>
  </Reveal>
</section>
