---
import Reveal from "./Reveal";
import Eyebrow from "./Eyebrow.astro";
import { site, waTreatmentLink } from "../data/site";

interface Props { headingLevel?: "h1" | "h2" }
const { headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;
const { treatments } = site;
---
<section id="treatments" class="max-w-7xl mx-auto px-5 py-20 lg:py-24">
  <Reveal client:visible>
    <div class="max-w-2xl" data-reveal-item>
      <Eyebrow>{treatments.eyebrow}</Eyebrow>
      <Heading class="mt-3 text-3xl sm:text-4xl font-extrabold tracking-tight">{treatments.heading}</Heading>
      <p class="mt-4 text-slate-600 leading-7">{treatments.text}</p>
    </div>
    <div class="mt-10 grid md:grid-cols-2 gap-5">
      {treatments.items.map((t, i) => (
        <div data-reveal-item>
          <article class="lift h-full rounded-3xl border border-slate-200 p-6 sm:p-7">
            <div class="flex items-start justify-between gap-5">
              <span class="h-11 w-11 rounded-2xl bg-mist grid place-items-center text-teal font-bold">{String(i + 1).padStart(2, "0")}</span>
            </div>
            <h3 class="mt-6 text-2xl font-bold">{t.title}</h3>
            <p class="mt-2 text-slate-600 leading-7">{t.text}</p>
            <a href={waTreatmentLink(t.topic)} target="_blank" rel="noopener noreferrer" class="btn-lift mt-6 block w-full text-center rounded-xl bg-teal text-white py-3.5 font-bold hover:bg-teal-dark focus-ring">{t.cta}</a>
          </article>
        </div>
      ))}
    </div>
  </Reveal>
</section>
