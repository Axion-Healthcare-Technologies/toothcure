---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Eyebrow from "../components/Eyebrow.astro";
import { site } from "../data/site";
---
<Base title={`Page not found | ${site.brand}`} noindex>
  <Header />
  <main id="main">
    <section class="hero-grid bg-sand">
      <div class="max-w-3xl mx-auto px-5 py-24 lg:py-32 text-center">
        <Eyebrow>404</Eyebrow>
        <h1 class="mt-3 text-4xl sm:text-5xl font-extrabold tracking-tight">Page not found</h1>
        <p class="mt-4 text-lg text-slate-600 leading-8">The page you are looking for does not exist or has moved.</p>
        <a href="/" class="btn-lift mt-8 inline-flex rounded-xl bg-teal text-white px-6 py-3.5 font-bold shadow-soft hover:bg-teal-dark focus-ring">Back to home</a>
      </div>
    </section>
  </main>
  <Footer />
</Base>
